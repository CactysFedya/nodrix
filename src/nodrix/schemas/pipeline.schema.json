        "from": {
          "title": "From",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "to": {
          "title": "To",
          "type": "string"
        },
        "uses": {
          "minLength": 1,
          "title": "Uses",
          "type": "string"
        }
      },
      "required": [
        "uses",
        "from",
        "to"
      ],
      "title": "ExternalLinkConfig",
      "type": "object"
    },
