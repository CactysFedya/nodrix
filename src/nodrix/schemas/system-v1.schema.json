        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "properties": {
          "additionalProperties": true,
          "title": "Properties",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "$id": "urn:nodrix:schema:system:v1",
  "additionalProperties": false,
  "description": "Declarative architecture of one executable system.\n\nSystemModel deliberately contains no runtime queues, scheduler decisions,\nprocess handles, or backend-specific execution plan. Those are compiled in\nlater layers.",
