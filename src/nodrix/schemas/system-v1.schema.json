        }
      },
      "title": "SystemBoundaryBindings",
      "type": "object"
    },
    "SystemDependency": {
      "additionalProperties": false,
      "description": "One explicit startup edge between sibling System instances.\n\n``system`` names the dependent sibling. ``requires`` names its prerequisite.\nThe edge belongs to their parent System Definition and therefore cannot\naddress ancestors, descendants, execution scopes, or backend objects.",
      "properties": {
        "condition": {
          "$ref": "#/$defs/SystemDependencyCondition"
        },
        "extensions": {
          "additionalProperties": true,
          "title": "Extensions",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "requires": {
          "minLength": 1,
          "title": "Requires",
          "type": "string"
        },
        "system": {
          "minLength": 1,
          "title": "System",
          "type": "string"
        },
        "timeoutSeconds": {
          "exclusiveMinimum": 0,
          "title": "Timeoutseconds",
          "type": "number"
        }
      },
      "required": [
        "system",
        "requires",
        "condition",
        "timeoutSeconds"
      ],
      "title": "SystemDependency",
      "type": "object"
    },
    "SystemDependencyCondition": {
      "description": "Startup condition that a prerequisite System must satisfy.",
      "enum": [
        "started",
        "ready",
        "healthy"
      ],
      "title": "SystemDependencyCondition",
      "type": "string"
    },
    "SystemInstance": {
      "additionalProperties": false,
      "description": "One exact child System Definition instantiated by a parent System.\n\n``uses`` is the canonical immutable RevisionRef of the child System\nDefinition. Filesystem paths, project aliases, source filenames, and\nunpinned EntityRefs are authoring concerns and must be resolved before\nconstructing the canonical SystemModel.\n\nA SystemInstance is part of the canonical architecture. It is not a\nSystem Module and does not disappear during source resolution.",
      "properties": {
        "extensions": {
          "additionalProperties": true,
          "title": "Extensions",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "uses": {
          "minLength": 1,
          "title": "Uses",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uses"
      ],
      "title": "SystemInstance",
      "type": "object"
    },
    "SystemLink": {
      "additionalProperties": false,
      "description": "Explicit boundary outside one local Graph.\n\nA link can connect an Application to a Graph node, or two Graphs. It is a\nmodel-level contract only; transport/backend realization is intentionally a\nlater planner concern.",
      "properties": {
        "extensions": {
          "additionalProperties": true,
          "title": "Extensions",
          "type": "object"
        },
        "from": {
          "title": "From",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "to": {
          "title": "To",
          "type": "string"
        },
        "type_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type Id"
        },
        "uses": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uses"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "SystemLink",
      "type": "object"
    },
    "SystemPort": {
      "additionalProperties": false,
      "description": "One externally visible typed port of a System Definition.\n\nSystemPort describes the logical contract exposed by a System. It does not\ndescribe transport realization, ROS topics, queues, processes, or backend\nrouting. Those concerns belong to composition/planning/integration layers.\n\n``type_id`` uses the same backend-neutral contract identity language as\nNodrix MessageDefinition/PortDefinition without making the canonical\nSystem Model depend on the SDK authoring frontend.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "extensions": {
          "additionalProperties": true,
          "title": "Extensions",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "type_id": {
          "minLength": 1,
          "title": "Type Id",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type_id"
      ],
      "title": "SystemPort",
      "type": "object"
    },
    "SystemPortBinding": {
      "additionalProperties": false,
      "description": "Bind one external System port to one internal endpoint.\n\nThe endpoint uses the existing canonical System endpoint vocabulary:\n\n- ``application.port``\n- ``graph/node.port``\n\nA binding contains no transport or backend realization. It only identifies\nwhere an external System contract is implemented internally.",
      "properties": {
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "extensions": {
          "additionalProperties": true,
          "title": "Extensions",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "port": {
          "minLength": 1,
          "title": "Port",
          "type": "string"
        }
      },
      "required": [
        "port",
        "endpoint"
      ],
      "title": "SystemPortBinding",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "description": "Declarative execution/deployment target.\n\nVersion 2.5 models targets only. Target resolution and deployment belong to\nthe 2.6 planner/backend layer.",
      "properties": {
        "kind": {
          "default": "local",
          "title": "Kind",
          "type": "string"
