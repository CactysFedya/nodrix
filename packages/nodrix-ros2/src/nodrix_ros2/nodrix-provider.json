{
  "metadata": {
    "description": "Universal ROS 2 orchestration, supervision and transport provider",
    "features": [
      "platform.ros2",
      "ros2.workspace",
      "ros2.colcon.if_needed",
      "ros2.node",
      "ros2.launch",
      "ros2.rviz",
      "ros2.topic_monitor",
      "ros2.topic_source",
      "ros2.topic_sink",
      "ros2.shared_executor"
    ],
    "id": "nodrix.ros2",
    "name": "Nodrix ROS 2 Provider",
    "provider_api": "1",
    "requires_features": [
      "python-node-api.2",
      "domain.spatial.contracts"
    ],
    "requires_nodrix": ">=2.1,<3",
    "version": "0.2.0"
  },
  "nodes": [
    {
      "factory": "nodrix_ros2.nodes.process_nodes:Ros2NodeProcess",
      "features": [
        "ros2.node",
        "ros2.process_supervision"
      ],
      "id": "ros2.node",
      "inputs": {},
      "optional_inputs": [],
      "outputs": {
        "status": "core.object"
      }
    },
    {
      "factory": "nodrix_ros2.nodes.process_nodes:Ros2LaunchProcess",
      "features": [
        "ros2.launch",
        "ros2.process_supervision"
      ],
      "id": "ros2.launch",
      "inputs": {},
      "optional_inputs": [],
      "outputs": {
        "status": "core.object"
      }
    },
    {
      "factory": "nodrix_ros2.nodes.process_nodes:Ros2RvizProcess",
      "features": [
        "ros2.rviz",
        "ros2.process_supervision"
      ],
      "id": "ros2.rviz",
      "inputs": {},
      "optional_inputs": [],
      "outputs": {
        "status": "core.object"
      }
    },
    {
      "factory": "nodrix_ros2.nodes.topic_monitor:Ros2TopicMonitor",
      "features": [
        "ros2.topic_monitor",
        "ros2.readiness"
      ],
      "id": "ros2.topic_monitor",
      "inputs": {},
      "optional_inputs": [],
      "outputs": {
        "status": "core.object"
      }
    },
    {
      "factory": "nodrix_ros2.nodes.topic_source:Ros2TopicSource",
      "features": [
        "ros2.topic_source"
      ],
      "id": "ros2.topic_source",
      "inputs": {},
      "optional_inputs": [],
      "outputs": {
        "output": "core.any"
      }
    },
    {
      "factory": "nodrix_ros2.nodes.topic_sink:Ros2TopicSink",
      "features": [
        "ros2.topic_sink"
      ],
      "id": "ros2.topic_sink",
      "inputs": {
        "input": "core.any"
      },
      "optional_inputs": [],
      "outputs": {}
    },
    {
      "factory": "nodrix_ros2.nodes.topic_source:Ros2PointCloud2Source",
      "features": [
        "ros2.point_cloud2"
      ],
      "id": "ros2.point_cloud2_source",
      "inputs": {},
      "optional_inputs": [],
      "outputs": {
        "cloud": "spatial.point_cloud/v1"
      }
    },
    {
      "factory": "nodrix_ros2.nodes.topic_source:Ros2ImuSource",
      "features": [
        "ros2.imu"
      ],
      "id": "ros2.imu_source",
      "inputs": {},
      "optional_inputs": [],
      "outputs": {
        "imu": "spatial.imu/v1"
      }
    },
    {
      "factory": "nodrix_ros2.nodes.topic_source:Ros2OdometrySource",
      "features": [
        "ros2.odometry"
      ],
      "id": "ros2.odometry_source",
      "inputs": {},
      "optional_inputs": [],
      "outputs": {
        "odometry": "spatial.odometry/v1"
      }
    }
  ],
  "probes": [
    {
      "callable": "nodrix_ros2.probes:safe_probe",
      "cooldown_seconds": 0.0,
      "depth": "safe",
      "id": "nodrix.ros2.safe",
      "permissions": [],
      "timeout_seconds": 2.0
    },
    {
      "callable": "nodrix_ros2.probes:deep_probe",
      "cooldown_seconds": 5.0,
      "depth": "deep",
      "id": "nodrix.ros2.deep",
      "permissions": [
        "ros-environment"
      ],
      "timeout_seconds": 5.0
    }
  ],
  "schema": "nodrix-provider/1",
  "templates": []
}
