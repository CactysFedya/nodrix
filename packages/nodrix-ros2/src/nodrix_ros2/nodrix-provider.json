{
  "schema": "nodrix-provider/2",
  "metadata": {
    "description": "Universal ROS 2 orchestration, supervision and transport provider",
    "features": [
      "platform.ros2",
      "ros2.workspace",
      "ros2.colcon.if_needed",
      "ros2.node",
      "ros2.launch",
      "ros2.rviz",
      "ros2.topic_monitor",
      "ros2.topic_source",
      "ros2.topic_sink",
      "ros2.shared_executor",
      "ros2.session",
      "ros2.graph.worker",
      "ros2.external_links"
    ],
    "id": "nodrix.ros2",
    "name": "Nodrix ROS 2 Provider",
    "provider_api": "2",
    "requires_features": [
      "python-node-api.2",
      "provider-sessions.1",
      "external-links.1"
    ],
    "requires_nodrix": ">=2.1,<3",
    "version": "0.3.0"
  },
  "nodes": [
    {
      "factory": "nodrix_ros2.nodes.process_nodes:Ros2NodeProcess",
      "features": [
        "ros2.node",
        "ros2.process_supervision"
      ],
      "id": "ros2.node",
      "inputs": {},
      "optional_inputs": [],
      "outputs": {
        "status": "core.object"
      },
      "parameters_schema": {
        "type": "object",
        "required": ["package", "executable"],
        "properties": {
          "package": {"type": "string", "minLength": 1},
          "executable": {"type": "string", "minLength": 1},
          "workspace": {"type": "object"},
          "remappings": {"type": "object"},
          "requires_topics": {"type": "array"}
        }
      }
    },
    {
      "factory": "nodrix_ros2.nodes.process_nodes:Ros2LaunchProcess",
      "features": [
        "ros2.launch",
        "ros2.process_supervision"
      ],
      "id": "ros2.launch",
      "inputs": {},
      "optional_inputs": [],
      "outputs": {
        "status": "core.object"
      },
      "parameters_schema": {
        "type": "object",
        "required": ["package", "launch_file"],
        "properties": {
          "package": {"type": "string", "minLength": 1},
          "launch_file": {"type": "string", "minLength": 1},
          "workspace": {"type": "object"},
          "arguments": {"type": "object"},
          "requires_topics": {"type": "array"}
        }
      }
    },
    {
      "factory": "nodrix_ros2.nodes.process_nodes:Ros2RvizProcess",
      "features": [
        "ros2.rviz",
        "ros2.process_supervision"
      ],
      "id": "ros2.rviz",
      "inputs": {},
      "optional_inputs": [],
      "outputs": {
        "status": "core.object"
      },
      "parameters_schema": {
        "type": "object",
        "properties": {
          "config": {"type": "string"},
          "workspace": {"type": "object"},
          "requires_topics": {"type": "array"}
        }
      }
    },
    {
      "factory": "nodrix_ros2.nodes.topic_monitor:Ros2TopicMonitor",
      "features": [
        "ros2.topic_monitor",
        "ros2.readiness"
      ],
      "id": "ros2.topic_monitor",
      "inputs": {},
      "optional_inputs": [],
      "outputs": {
        "status": "core.object"
      },
      "parameters_schema": {
        "type": "object",
        "required": ["topic", "message_type"],
        "properties": {
          "mode": {"enum": ["graph", "sample", "statistics"]},
          "topic": {"type": "string", "minLength": 1},
          "message_type": {"type": "string", "minLength": 1},
          "startup_timeout_s": {"type": "number", "exclusiveMinimum": 0},
          "sample_interval_s": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    {
      "factory": "nodrix_ros2.nodes.topic_source:Ros2TopicSource",
      "features": [
        "ros2.topic_source"
      ],
      "id": "ros2.topic_source",
      "inputs": {},
      "optional_inputs": [],
      "outputs": {
        "output": "core.any"
      },
      "parameters_schema": {
        "type": "object",
        "required": ["topic", "message_type"],
        "properties": {
          "topic": {"type": "string", "minLength": 1},
          "message_type": {"type": "string", "minLength": 1},
          "capacity": {"type": "integer", "minimum": 1}
        }
      }
    },
    {
      "factory": "nodrix_ros2.nodes.topic_sink:Ros2TopicSink",
      "features": [
        "ros2.topic_sink"
      ],
      "id": "ros2.topic_sink",
      "inputs": {
        "input": "core.any"
      },
      "optional_inputs": [],
      "outputs": {},
      "parameters_schema": {
        "type": "object",
        "required": ["topic", "message_type"],
        "properties": {
          "topic": {"type": "string", "minLength": 1},
          "message_type": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "factory": "nodrix_ros2.nodes.topic_source:Ros2TopicSource",
      "features": ["ros2.topic_source", "compatibility.alias"],
      "id": "ros2.source",
      "inputs": {},
      "optional_inputs": [],
      "outputs": {"output": "core.any"},
      "parameters_schema": {
        "type": "object",
        "required": ["topic", "message_type"],
        "properties": {
          "topic": {"type": "string", "minLength": 1},
          "message_type": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "factory": "nodrix_ros2.nodes.topic_sink:Ros2TopicSink",
      "features": ["ros2.topic_sink", "compatibility.alias"],
      "id": "ros2.sink",
      "inputs": {"input": "core.any"},
      "optional_inputs": [],
      "outputs": {},
      "parameters_schema": {
        "type": "object",
        "required": ["topic", "message_type"],
        "properties": {
          "topic": {"type": "string", "minLength": 1},
          "message_type": {"type": "string", "minLength": 1}
        }
      }
    }
  ],
  "probes": [
    {
      "callable": "nodrix_ros2.probes:safe_probe",
      "cooldown_seconds": 0.0,
      "depth": "safe",
      "id": "nodrix.ros2.safe",
      "permissions": [],
      "timeout_seconds": 2.0
    },
    {
      "callable": "nodrix_ros2.probes:deep_probe",
      "cooldown_seconds": 5.0,
      "depth": "deep",
      "id": "nodrix.ros2.deep",
      "permissions": [
        "ros-environment"
      ],
      "timeout_seconds": 5.0
    }
  ],
  "templates": [
    {
      "id": "ros2",
      "source": "templates/ros2-fast-livo2",
      "description": "ROS 2 project with one shared workspace and graph session",
      "features": ["platform.ros2", "ros2.session"]
    },
    {
      "id": "ros2-fast-livo2",
      "source": "templates/ros2-fast-livo2",
      "description": "Livox and FAST-LIVO2 orchestration with one ROS session",
      "features": ["platform.ros2", "ros2.session"]
    }
  ],
  "sessions": [
    {
      "id": "ros2.session",
      "factory": "nodrix_ros2.session:Ros2Session",
      "features": ["ros2.workspace", "ros2.graph.worker"],
      "parameters_schema": {
        "type": "object",
        "properties": {
          "distro": {"type": "string", "default": "jazzy"},
          "path": {"type": "string"},
          "trust": {"enum": ["project", "explicit", "readonly"]},
          "build": {"type": "object"}
        }
      }
    }
  ],
  "links": [
    {
      "id": "ros2.topic",
      "features": ["ros2.external_links"],
      "parameters_schema": {
        "type": "object",
        "required": ["topic", "message_type"],
        "properties": {
          "topic": {"type": "string"},
          "message_type": {"type": "string"},
          "qos": {"type": "object"}
        }
      }
    }
  ]
}
