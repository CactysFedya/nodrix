{
  "schema": "nodrix-provider/1",
  "metadata": {
    "id": "nodrix.ros2.spatial",
    "name": "Nodrix ROS 2 Spatial Bridges",
    "version": "0.1.0",
    "provider_api": "1",
    "requires_nodrix": ">=2.1,<3",
    "description": "Typed ROS 2 PointCloud, IMU, and Odometry bridges",
    "features": [
      "bridge.ros2.spatial",
      "ros2.point_cloud2",
      "ros2.imu",
      "ros2.odometry"
    ],
    "requires_features": [
      "platform.ros2",
      "domain.spatial.contracts"
    ]
  },
  "nodes": [
    {
      "id": "ros2.point_cloud2_source",
      "factory": "nodrix_spatial_ros2.nodes.topic_source:Ros2PointCloud2Source",
      "inputs": {},
      "outputs": {"cloud": "spatial.point_cloud/v1"},
      "optional_inputs": [],
      "features": ["ros2.point_cloud2"],
      "parameters_schema": {
        "type": "object",
        "required": ["topic"],
        "properties": {
          "topic": {"type": "string", "minLength": 1},
          "message_type": {"type": "string"},
          "capacity": {"type": "integer", "minimum": 1}
        }
      }
    },
    {
      "id": "ros2.imu_source",
      "factory": "nodrix_spatial_ros2.nodes.topic_source:Ros2ImuSource",
      "inputs": {},
      "outputs": {"imu": "spatial.imu/v1"},
      "optional_inputs": [],
      "features": ["ros2.imu"],
      "parameters_schema": {
        "type": "object",
        "required": ["topic"],
        "properties": {
          "topic": {"type": "string", "minLength": 1},
          "message_type": {"type": "string"},
          "capacity": {"type": "integer", "minimum": 1}
        }
      }
    },
    {
      "id": "ros2.odometry_source",
      "factory": "nodrix_spatial_ros2.nodes.topic_source:Ros2OdometrySource",
      "inputs": {},
      "outputs": {"odometry": "spatial.odometry/v1"},
      "optional_inputs": [],
      "features": ["ros2.odometry"],
      "parameters_schema": {
        "type": "object",
        "required": ["topic"],
        "properties": {
          "topic": {"type": "string", "minLength": 1},
          "message_type": {"type": "string"},
          "capacity": {"type": "integer", "minimum": 1}
        }
      }
    }
  ],
  "probes": [],
  "templates": []
}
